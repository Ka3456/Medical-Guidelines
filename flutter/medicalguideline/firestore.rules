rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
        // chat_roomsコレクション: ログイン済みユーザーが自分のデータのみ読み書き可能
        match /chat_rooms/{userId} {
            allow read, write: if request.auth != null && request.auth.uid == userId;
            
            // サブコレクション rooms も同様
            match /rooms/{roomId} {
                allow read, write: if request.auth != null && request.auth.uid == userId;
                
                // messages サブコレクション
                match /messages/{messageId} {
                    allow read, write: if request.auth != null && request.auth.uid == userId;
                }
            }
        }

        // err_reportコレクション: ログイン済みユーザーが読み書き可能
        match /err_report/{document} {
            allow read, write: if request.auth != null;
        }

        // usersコレクション: ログイン済みユーザーが自分のデータのみ読み書き可能
        match /users/{userId} {
            allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // notification コレクション
        match /notification/{userId} {
            allow read: if request.auth != null && request.auth.uid == userId;
            
            // notifications サブコレクション
            match /notifications/{notificationId} {
                allow read, write: if request.auth != null && request.auth.uid == userId;
            }
        }

        // notification_all コレクション: 全員が読み取り可能
        match /notification_all/{document} {
            allow read: if request.auth != null;
        }
    }
}
